# Copy to the project root as .env.local, then restart `next dev`.

# --- Backend ------------------------------------------------------------------
# Leave EMPTY to use the built-in mock server (no backend needed).
# Set to the Laravel API base URL (include the /api prefix if your routes have one) to use the real backend.
NEXT_PUBLIC_API_URL=

# Mock mode only: fake network delay in ms (0 = instant).
NEXT_PUBLIC_MOCK_LATENCY=200

# --- Festival campaigns (optional) ---------------------------------------------
# Read campaigns from a different URL than NEXT_PUBLIC_API_URL + /campaigns.
# CAMPAIGNS_API_URL=
# Preview festival themes locally without touching dates: eid,boishakh,puja
# CAMPAIGN_PREVIEW=
