# Copy to the project root as .env.local, then restart `next dev`.

# --- Backend ------------------------------------------------------------------
# Leave EMPTY to use the built-in mock server (no backend needed).
# Set to the Laravel API base URL (include the /api prefix if your routes have one) to use the real backend.
NEXT_PUBLIC_API_URL=

# Multi-shop backends (Dokani Cloud): the shop this website belongs to. Sent as the header  X-Shop-Id  on every API call.
# The backend uses it to pick that shop's Dokani login, products and stock. Never put Dokani passwords or tokens here.
NEXT_PUBLIC_SHOP_ID=

# Mock mode only: fake network delay in ms (0 = instant).
NEXT_PUBLIC_MOCK_LATENCY=200

# --- Festival campaigns (optional) ---------------------------------------------
# Read campaigns from a different URL than NEXT_PUBLIC_API_URL + /campaigns.
# CAMPAIGNS_API_URL=
# Preview festival themes locally without touching dates: eid,boishakh,puja
# CAMPAIGN_PREVIEW=

# --- Dokani Cloud (products come from the shop's Dokani account) ---------------
# SERVER ONLY: no NEXT_PUBLIC_ prefix, never commit the real values. Leave empty to keep the built-in demo products.
DOKANI_BASE_URL=
DOKANI_LOGIN=
DOKANI_PASSWORD=
# Safety check: the shop id the login must belong to (IT lab = 552). A different shop is refused.
DOKANI_SHOP_ID=
# Needed later, when sales are created in Dokani (IT lab main branch = 494).
DOKANI_BRANCH_ID=
# Show /api/dokani/health in production too (leave unset in production).
# DOKANI_DEBUG=1
